# ============================================
# RAG Docs - Environment Configuration
# ============================================
# Copiá este archivo a .env y completá los valores
# cp .env.example .env

# ----- Google Gemini (GRATIS) -----
# Obtené tu API key en: https://aistudio.google.com/app/apikey
# Free tier: 1,500 requests/día, 1M tokens/min
GOOGLE_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash-exp
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-base

# ----- Vector Store -----
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=spark_docs
BM25_PERSIST_PATH=./data/bm25_index.pkl

# ----- Chunking -----
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ----- Retrieval -----
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_RERANK=5
RRF_K=60

# ----- Langfuse (opcional pero recomendado) -----
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
